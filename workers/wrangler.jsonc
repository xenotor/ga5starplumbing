{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ga5starplumbing",
  // This project has a dedicated Cloudflare account and shares nothing with any
  // other project. Pinning the id here is what enforces that: wrangler refuses
  // to deploy if the active credentials belong to a different account, so a
  // stray `wrangler login` on a machine that also has other Cloudflare work
  // cannot put this Worker in the wrong place. Never widen this to a variable.
  "account_id": "3424bc3970f0faf1dbedd8a0c19a9a00",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Both hostnames are custom domains on this account's zone. These must stay
  // in the config: wrangler syncs triggers on every deploy, so removing them
  // would detach the live domain on the next CI run. www is a custom domain
  // rather than a DNS alias so the Worker owns the redirect to the apex.
  "routes": [
    { "pattern": "ga5starplumbing.com", "custom_domain": true },
    { "pattern": "www.ga5starplumbing.com", "custom_domain": true }
  ],

  "workers_dev": true,

  // React SPA served as static assets, with the Worker in front of page
  // requests (see run_worker_first below).
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Page requests run the Worker first so the www -> apex redirect in
    // src/index.ts actually fires; a request served straight from assets never
    // reaches our code. The negative rules keep that cost off static files:
    // hashed bundles and images are served by the asset worker for free, so a
    // page view costs one invocation rather than one per subresource.
    // booking-embed.* is excluded for the same reason and because other sites
    // hotlink it by exact name — it must never cost an invocation per view.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/images/*",
      "!/booking-embed.js",
      "!/booking-embed.css",
      "!/favicon.ico",
      "!/robots.txt"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ga5starplumbing",
      "database_id": "893e4a8c-e4ac-45f0-b15a-deefd08763f9",
      "migrations_dir": "migrations"
    }
  ],

  // Booking funnel telemetry keyed by Facebook campaign (see src/lib/analytics.ts).
  //
  // Commented out because Analytics Engine is an account-level opt-in and this
  // account has not enabled it yet; deploying with the binding fails the whole
  // release [code 10089]. src/lib/analytics.ts treats the binding as optional,
  // so bookings work without it — only the aggregate funnel view is missing.
  // Per-campaign booking counts come from D1 (/api/admin/attribution) and are
  // unaffected. To turn it on, enable Analytics Engine at
  // dash.cloudflare.com/<account>/workers/analytics-engine, then uncomment.
  // "analytics_engine_datasets": [
  //   {
  //     "binding": "BOOKING_ANALYTICS",
  //     "dataset": "ga5starplumbing_bookings"
  //   }
  // ],

  "observability": { "enabled": true },

  "vars": {
    "ENV": "prod",
    "BUSINESS_TZ": "America/New_York"
  }
  // Secrets: ADMIN_TOKEN, NOTIFY_EMAIL_TO, NOTIFY_EMAIL_FROM (optional),
  // FACEBOOK_CAPI_TOKEN / FACEBOOK_PIXEL_ID (optional) — set from GitHub Secrets.
}
