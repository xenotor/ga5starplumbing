# Cloudflare Workers static-asset headers.
#
# The booking embed is loaded as a module script from other landing pages, and
# cross-origin module scripts are fetched in CORS mode — without this header the
# browser blocks the file before any of our code runs. The Worker cannot add it:
# these paths are excluded from run_worker_first so they stay free to serve.
/booking-embed.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

/booking-embed.css
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate
