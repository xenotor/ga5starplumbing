# Meta. Empty until the shop's own Business Manager, ad account, page and pixel
# exist — see docs/meta_assets.md. This account is unrelated to any other Meta
# account on this machine.
META_TOKEN=
META_AD_ACCOUNT=
META_PAGE_ID=
META_PIXEL_ID=

# Booking attribution is read over HTTP from the Worker's admin API. Same
# ADMIN_TOKEN the shop uses for /api/admin/appointments; no Cloudflare
# credentials and no direct D1 access (docs/measurement.md).
WORKER_URL=https://ga5starplumbing.com
ADMIN_TOKEN=

# Optimizer thresholds, in cents. Target CAC is what the shop will pay for one
# booking; minimum spend is how much a campaign must spend before its numbers
# are allowed to decide anything.
TARGET_CAC_CENTS=4000
MIN_SPEND_CENTS=10000
