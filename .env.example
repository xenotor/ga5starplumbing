# Developer-machine settings for the Makefile. Copy before first use:
#
#   cp .env.example .env
#
# `make` includes .env when it exists and exports every key, so these reach
# wrangler and any curl you run through a make target. This file is for TOOLING
# credentials; Worker runtime secrets belong in workers/.dev.vars instead.
#
# Plain make syntax: no quotes, no `export`, no spaces around `=`.

# The dedicated Cloudflare account for this project. Not a secret — the same id
# is pinned in workers/wrangler.jsonc, which makes wrangler refuse to act under
# credentials belonging to any other account.
CLOUDFLARE_ACCOUNT_ID=3424bc3970f0faf1dbedd8a0c19a9a00

# Account-scoped API token for the account above; required by `make deploy` and
# `make d1-migrate`. Get it from the project owner or mint one at
# dash.cloudflare.com/<account>/api-tokens with Workers Scripts:Edit and D1:Edit.
# An interactive `wrangler login` is NOT a substitute if your session belongs to
# a different account — wrangler will refuse on the pinned account_id.
CLOUDFLARE_API_TOKEN=

# Convenience for hitting the deployed API by hand — `make admin-appointments`
# reads these. ADMIN_TOKEN must match whatever the target environment holds:
# workers/.dev.vars for localhost, the production secret for the live Worker.
WORKER_URL=http://localhost:8787
ADMIN_TOKEN=local-dev-token
