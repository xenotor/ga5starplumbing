# Developer-machine settings for the Makefile. Copy before first use:
#
#   cp .env.example .env
#
# `make` includes .env when it exists and exports every key, so these reach
# wrangler and any curl you run through a make target. This file is for TOOLING
# credentials; Worker runtime secrets belong in workers/.dev.vars instead.
#
# Plain make syntax: no quotes, no `export`, no spaces around `=`.

# Cloudflare account that owns the Worker, D1 database, and assets.
# Find it with: npx wrangler whoami
CLOUDFLARE_ACCOUNT_ID=0000000000000000000000000000000

# Optional. Leave blank to use your interactive `npx wrangler login` session,
# which is the normal path for local work. Set it only for unattended runs
# (a script, a container) with a token scoped to Workers + D1 edit.
CLOUDFLARE_API_TOKEN=

# Convenience for hitting the deployed API by hand — `make admin-appointments`
# reads these. ADMIN_TOKEN must match whatever the target environment holds:
# workers/.dev.vars for localhost, the production secret for the live Worker.
WORKER_URL=http://localhost:8787
ADMIN_TOKEN=local-dev-token
